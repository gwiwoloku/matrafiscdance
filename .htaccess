RewriteEngine On

# Cloudflare Flexible SSL terminates HTTPS at Cloudflare and connects to
# Fasthosts over HTTP. Do not force HTTPS at the origin or this creates a
# redirect loop. Only canonicalise the www hostname here.
RewriteCond %{HTTP_HOST} ^www\.matrafiscdance\.com$ [NC]
RewriteRule ^ https://matrafiscdance.com%{REQUEST_URI} [R=301,L]

Redirect 301 /company/ /about-us/
Redirect 301 /contact/ /contact-us/
Redirect 301 /works/ /projects/
Redirect 301 /repertoire/ /projects/
Redirect 301 /news/ /
Redirect 301 /it/company/ /it/compagnia/
Redirect 301 /it/projects/ /it/progetti/
Redirect 301 /it/contact/ /it/contatti/
Redirect 301 /it/touring/ /it/tournee/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

ErrorDocument 404 /404.html

Redirect 301 /1-plus-1-equals-1/ /111-2/
Redirect 301 /that-place-over-there/ /salford-university/
Redirect 301 /study-of-hands-2/ /valeria-famularo/
Redirect 301 /monkey-and-leopard/ /jo-lau/
Redirect 301 /tightrope-walkers/ /akerusia-danza/

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
